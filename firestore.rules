rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidWishlistItem(data, userId, itemId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'appId',
        'name',
        'developer',
        'platform',
        'category',
        'thumbnail',
        'officialUrl',
        'directDownloadUrl',
        'addedAt',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'appId',
        'name',
        'developer',
        'platform',
        'category',
        'thumbnail',
        'officialUrl',
        'directDownloadUrl',
        'secondarySourceUrl',
        'secondarySourceLabel',
        'wingetId',
        'chocoId',
        'addedAt',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id == itemId &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId == userId &&
      data.userId == request.auth.uid &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.appId is string && data.appId.size() >= 1 && data.appId.size() <= 128 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
      data.developer is string && data.developer.size() >= 1 && data.developer.size() <= 200 &&
      data.platform in ['pc', 'android', 'ios'] &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
      data.thumbnail is string && data.thumbnail.size() >= 1 && data.thumbnail.size() <= 2048 &&
      data.officialUrl is string && data.officialUrl.size() >= 1 && data.officialUrl.size() <= 2048 &&
      data.directDownloadUrl is string && data.directDownloadUrl.size() >= 1 && data.directDownloadUrl.size() <= 2048 &&
      (!('secondarySourceUrl' in data) || (data.secondarySourceUrl is string && data.secondarySourceUrl.size() <= 2048)) &&
      (!('secondarySourceLabel' in data) || (data.secondarySourceLabel is string && data.secondarySourceLabel.size() <= 120)) &&
      (!('wingetId' in data) || (data.wingetId is string && data.wingetId.size() <= 160)) &&
      (!('chocoId' in data) || (data.chocoId is string && data.chocoId.size() <= 160)) &&
      data.addedAt is number && data.addedAt > 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /users/{userId}/wishlist/{itemId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidId(itemId) &&
        request.auth.uid == userId &&
        isValidWishlistItem(incoming(), userId, itemId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidId(itemId) &&
        request.auth.uid == userId &&
        isValidWishlistItem(incoming(), userId, itemId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().appId == existing().appId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'developer',
          'category',
          'thumbnail',
          'officialUrl',
          'directDownloadUrl',
          'secondarySourceUrl',
          'secondarySourceLabel',
          'wingetId',
          'chocoId',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId && existing().userId == request.auth.uid;
    }
  }
}
